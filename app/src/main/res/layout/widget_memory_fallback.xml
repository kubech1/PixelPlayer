<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
 android:gravity="center" android:background="#202124" android:padding="4dp">
 <ImageButton android:id="@+id/widget_fallback_previous" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/rounded_skip_previous_24" android:contentDescription="@string/widget_previous" android:background="@android:color/transparent" />
 <ImageButton android:id="@+id/widget_fallback_play" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/rounded_play_arrow_24" android:contentDescription="@string/widget_play_pause" android:background="@android:color/transparent" />
 <ImageButton android:id="@+id/widget_fallback_next" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/rounded_skip_next_24" android:contentDescription="@string/widget_next" android:background="@android:color/transparent" />
</LinearLayout>
